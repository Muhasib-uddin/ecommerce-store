# Base node image
FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g turbo

# Prune step to only copy what is needed
FROM base AS pruner
COPY . .
RUN turbo prune api --out=json-out

# Install dependencies step
FROM base AS installer
COPY --from=pruner /app/json-out/json/ .
COPY --from=pruner /app/json-out/package-lock.json ./package-lock.json
RUN npm clean-install

# Build step
FROM base AS builder
COPY --from=installer /app/ .
COPY --from=pruner /app/json-out/full/ .
RUN npx turbo run build --filter=api...

# Production runner
FROM node:20-alpine AS runner
WORKDIR /app
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/package.json ./package.json
COPY --from=builder /app/apps/api/node_modules ./node_modules

EXPOSE 5000
CMD ["node", "dist/index.js"]
