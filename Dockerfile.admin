# Base node image
FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g turbo

# Prune step
FROM base AS pruner
COPY . .
RUN turbo prune admin --out=json-out

# Install dependencies step
FROM base AS installer
COPY --from=pruner /app/json-out/json/ .
COPY --from=pruner /app/json-out/package-lock.json ./package-lock.json
# Using --legacy-peer-deps for React 19 compatibility with legacy UI libraries
RUN npm clean-install --legacy-peer-deps

# Build step
FROM base AS builder
COPY --from=installer /app/ .
COPY --from=pruner /app/json-out/full/ .
# Inject env vars for build time if necessary
RUN npx turbo run build --filter=admin...

# Production server step (Nginx)
FROM nginx:1.25-alpine AS runner
COPY --from=builder /app/apps/admin/dist /usr/share/nginx/html
# Custom nginx config to handle SPA routing
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
