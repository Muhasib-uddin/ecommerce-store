# ==============================================================================
# MONOREPO — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# Copy this file to .env.production or .env.prod for production deployments.
# ==============================================================================

NODE_ENV=production
PORT=5000
STORE_NAME="LUMIÈRE Store"
STORE_URL="https://yourstore.com"

API_URL="https://api.yourstore.com"
FRONTEND_URL="https://yourstore.com"
ADMIN_URL="https://admin.yourstore.com"

DATABASE_URL="postgresql://postgres:YOUR_PROD_DB_PASSWORD@your-db-host.com:5432/ecommerce?schema=public&sslmode=require"
REDIS_URL="redis://default:YOUR_REDIS_PASSWORD@your-redis-host.com:6379"
REDIS_PASSWORD="YOUR_REDIS_PASSWORD"

JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_STRONG_RANDOM_ACCESS_SECRET_64_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_STRONG_RANDOM_REFRESH_SECRET_64_CHARS"
JWT_SECRET="CHANGE_ME_GENERATE_STRONG_RANDOM_ACCESS_SECRET_64_CHARS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

NEXT_PUBLIC_API_URL="https://api.yourstore.com/api/v1"
NEXT_PUBLIC_APP_URL="https://yourstore.com"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_YOUR_STRIPE_LIVE_PUBLISHABLE_KEY"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="YOUR_PAYPAL_PRODUCTION_CLIENT_ID"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="YOUR_META_PIXEL_ID"

VITE_APP_DEFAULTAUTH=real
VITE_APP_API_URL="https://api.yourstore.com"

STRIPE_PUBLISHABLE_KEY="pk_live_YOUR_STRIPE_LIVE_PUBLISHABLE_KEY"
STRIPE_SECRET_KEY="sk_live_YOUR_STRIPE_LIVE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_LIVE_WEBHOOK_SECRET"
STRIPE_CURRENCY="USD"

PAYPAL_CLIENT_ID="YOUR_PAYPAL_PRODUCTION_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_PRODUCTION_CLIENT_SECRET"
PAYPAL_MODE="live"
PAYPAL_WEBHOOK_ID="YOUR_PAYPAL_PRODUCTION_WEBHOOK_ID"

RESEND_API_KEY="re_live_YOUR_RESEND_PRODUCTION_KEY"
EMAIL_FROM="orders@yourstore.com"

ACTIVITY_RETENTION_DAYS=90

META_PIXEL_ID="YOUR_META_PIXEL_ID"
META_CAPI_TOKEN="YOUR_META_CONVERSIONS_API_TOKEN"
GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
GTM_ID="GTM-XXXXXXX"

AWS_ACCESS_KEY_ID="YOUR_AWS_OR_R2_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_OR_R2_SECRET_ACCESS_KEY"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="your-production-bucket"
S3_ENDPOINT=""

WEBHOOK_SECRET="CHANGE_ME_GENERATE_STRONG_RANDOM_WEBHOOK_SECRET"
