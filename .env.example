# --- Server Configuration ---
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# --- Database & Cache ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# --- Security & Authentication ---
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Payment Gateways ---
# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY="USD"

# PayPal
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_MODE="sandbox" # sandbox or live

# --- Outbound Integrations ---
# Email (Resend/SendGrid/SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_user"
SMTP_PASS="smtp_pass"
SMTP_FROM="noreply@yourstore.com"

# Media Storage (AWS S3 or Cloudflare R2)
AWS_ACCESS_KEY_ID="your_s3_key_id"
AWS_SECRET_ACCESS_KEY="your_s3_secret_key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="your-store-assets"
S3_ENDPOINT="" # Leave blank for AWS S3, set for Cloudflare R2 (e.g., https://<account-id>.r2.cloudflarestorage.com)

# --- Marketing & Analytics ---
META_PIXEL_ID="your_meta_pixel_id"
META_CAPI_TOKEN="your_meta_capi_token"
GA4_MEASUREMENT_ID="your_ga4_id"
GTM_ID="your_gtm_id"

# --- Webhooks (Outbound Events) ---
WEBHOOK_SECRET="your_webhook_hmac_signing_secret"
